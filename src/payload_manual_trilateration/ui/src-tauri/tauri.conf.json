{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm --prefix ../../shared/ui run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm --prefix ../../shared/ui run build",
    "frontendDist": "../../../shared/ui/dist"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default permissions for the Avion manual control window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Payload Manual Trilateration",
        "width": 900,
        "height": 700,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../shared/ui/src-tauri/icons/32x32.png",
      "../../../shared/ui/src-tauri/icons/128x128.png",
      "../../../shared/ui/src-tauri/icons/128x128@2x.png",
      "../../../shared/ui/src-tauri/icons/icon.icns",
      "../../../shared/ui/src-tauri/icons/icon.ico"
    ]
  },
  "productName": "Payload Manual Trilateration",
  "identifier": "ca.ulaval.cia.payload-manual-trilateration"
}
