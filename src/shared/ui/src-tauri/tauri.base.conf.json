{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://localhost:1421",
    "frontendDist": "../../../shared/ui/dist"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default permissions for the Avion manual control window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../shared/ui/src-tauri/icons/32x32.png",
      "../../../shared/ui/src-tauri/icons/128x128.png",
      "../../../shared/ui/src-tauri/icons/128x128@2x.png",
      "../../../shared/ui/src-tauri/icons/icon.icns",
      "../../../shared/ui/src-tauri/icons/icon.ico"
    ]
  }
}
