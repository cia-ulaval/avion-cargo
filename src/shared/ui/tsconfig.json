{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "../../payload_manual/ui/src/**/*.ts",
    "../../payload_manual/ui/src/**/*.vue",
    "../../payload_manual_trilateration/ui/src/**/*.ts",
    "../../payload_manual_trilateration/ui/src/**/*.vue"
  ]
}
