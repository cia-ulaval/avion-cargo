{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Payload Manual Control",
  "version": "0.1.0",
  "identifier": "ca.ulaval.cia.payload-manual-control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Payload Manual Control",
        "width": 900,
        "height": 700,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
