        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>left_tilt_joint</joint_name>
            <joint_name>right_tilt_joint</joint_name>
            <joint_name>left_propeller_joint</joint_name>
            <joint_name>right_propeller_joint</joint_name>
            <joint_name>back_propeller_joint</joint_name>
            <joint_name>left_flap_joint</joint_name>
            <joint_name>right_flap_joint</joint_name>
            <joint_name>back_flap_joint</joint_name>
        </plugin>
        <!--
      PROVISIONAL FIXED-WING AERODYNAMICS
      Estimate based on approx. 0.65 m span x 0.60 m overall length.
      Assumptions: aircraft +X points forward; +Z is up; rho=1.2041 kg/m^3.
      Effective wing area is split between left/right halves (0.045 m^2 each).
      These are starter coefficients for experimentation, not validated data.
    -->
        <!-- Main wing: left half. CP is behind the provisional CG to provide
         a restoring pitch moment and outboard to provide roll damping. -->
        <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
            <link_name>main_frame</link_name>
            <air_density>1.2041</air_density>
            <area>0.045</area>
            <a0>0.035</a0>
            <cla>4.2</cla>
            <cda>0.35</cda>
            <cma>0.0</cma>
            <alpha_stall>0.28</alpha_stall>
            <cla_stall>-1.2</cla_stall>
            <cda_stall>1.2</cda_stall>
            <cma_stall>0.0</cma_stall>
            <forward>1 0 0</forward>
            <upward>0 0 1</upward>
            <cp>-0.02 0.15 0.015</cp>
        </plugin>
        <!-- Main wing: right half. Separate application point provides
         angular-rate-dependent rolling moments. -->
        <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
            <link_name>main_frame</link_name>
            <air_density>1.2041</air_density>
            <area>0.045</area>
            <a0>0.035</a0>
            <cla>4.2</cla>
            <cda>0.35</cda>
            <cma>0.0</cma>
            <alpha_stall>0.28</alpha_stall>
            <cla_stall>-1.2</cla_stall>
            <cda_stall>1.2</cda_stall>
            <cma_stall>0.0</cma_stall>
            <forward>1 0 0</forward>
            <upward>0 0 1</upward>
            <cp>-0.02 -0.15 0.015</cp>
        </plugin>
        <!-- Approximate parasitic fuselage / exposed-frame drag. This uses a
         drag-only LiftDrag instance (cla=0); the nonzero a0 creates a
         modest baseline drag because this system's cda is a slope vs alpha. -->
        <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
            <link_name>main_frame</link_name>
            <air_density>1.2041</air_density>
            <area>0.03</area>
            <a0>0.25</a0>
            <cla>0.0</cla>
            <cda>0.45</cda>
            <cma>0.0</cma>
            <alpha_stall>1.0</alpha_stall>
            <cla_stall>0.0</cla_stall>
            <cda_stall>0.8</cda_stall>
            <cma_stall>0.0</cma_stall>
            <forward>1 0 0</forward>
            <upward>0 0 1</upward>
            <cp>-0.04 0 0.015</cp>
        </plugin>
        <!-- Approximate side-force/directional stability from the fuselage and
         any vertical side area. Refine/remove this once fin geometry is measured. -->
        <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
            <link_name>main_frame</link_name>
            <air_density>1.2041</air_density>
            <area>0.004</area>
            <a0>0.0</a0>
            <cla>2.5</cla>
            <cda>0.35</cda>
            <cma>0.0</cma>
            <alpha_stall>0.40</alpha_stall>
            <cla_stall>-1.2</cla_stall>
            <cda_stall>1.0</cda_stall>
            <cma_stall>0.0</cma_stall>
            <forward>1 0 0</forward>
            <upward>0 1 0</upward>
            <cp>-0.22 0 0.025</cp>
        </plugin>
        <!-- Left and right movable flap/aft control surfaces. Aerodynamic forces
         act on the actual flap links so deflection changes their orientation. -->
        <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
            <link_name>left_flap</link_name>
            <air_density>1.2041</air_density>
            <area>0.006</area>
            <a0>0.0</a0>
            <cla>3.5</cla>
            <cda>0.35</cda>
            <cma>0.0</cma>
            <alpha_stall>0.35</alpha_stall>
            <cla_stall>-1.2</cla_stall>
            <cda_stall>1.2</cda_stall>
            <cma_stall>0.0</cma_stall>
            <forward>1 0 0</forward>
            <upward>0 0 1</upward>
            <cp>-0.012 0 0</cp>
        </plugin>
        <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
            <link_name>right_flap</link_name>
            <air_density>1.2041</air_density>
            <area>0.006</area>
            <a0>0.0</a0>
            <cla>3.5</cla>
            <cda>0.35</cda>
            <cma>0.0</cma>
            <alpha_stall>0.35</alpha_stall>
            <cla_stall>-1.2</cla_stall>
            <cda_stall>1.2</cda_stall>
            <cma_stall>0.0</cma_stall>
            <forward>1 0 0</forward>
