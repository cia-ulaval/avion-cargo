<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.9">
    <model name="tricopter_vtol">
        <static>false</static>
        <self_collide>false</self_collide>
        <link name="main_frame">
            <pose>0 0 0 0 0 0</pose>
            <gravity>true</gravity>
            <inertial>
                <mass>1</mass>
                <inertia>
                    <ixx>0.1</ixx>
                    <iyy>0.1</iyy>
                    <izz>0.1</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <collision name="main_frame_collision">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>meshes/main-frame.obj</uri>
                        <scale>0.1 0.1 0.1</scale>
                    </mesh>
                </geometry>
            </collision>
            <visual name="main_frame_visual">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>meshes/main-frame.obj</uri>
                        <scale>0.1 0.1 0.1</scale>
                    </mesh>
                </geometry>
            </visual>
            <sensor name="imu_sensor" type="imu">
                <!-- IMU uses ArduPilot's forward-right-down body frame. -->
                <pose degrees="true">0 0 0 180 0 0</pose>
                <always_on>true</always_on>
                <update_rate>1000</update_rate>
                <visualize>false</visualize>
            </sensor>
            <!-- Downward rangefinder, offset forward so its beam clears the fuselage collision mesh. -->
            <sensor name="sonar" type="gpu_lidar">
                <pose>-0.193178 0 0.0076394 0 1.57079632679 0</pose>
                <always_on>true</always_on>
                <update_rate>20</update_rate>
                <visualize>false</visualize>
                <topic>/model/tricopter_vtol/sonar/scan</topic>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.10</min>
                        <max>40.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>
        </link>
