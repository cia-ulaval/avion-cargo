            <joint_name>wheel_1_joint</joint_name>
            <joint_name>wheel_2_joint</joint_name>
        </plugin>
        <plugin filename="libd3k_gazebo_system.so" name="d3k_sim::D3kNodeSystem">
            <uart>
                <pty_path>/tmp/payload-anchor</pty_path>
                <baud_rate>460800</baud_rate>
            </uart>
            <reference_link>d3k_center_antenna</reference_link>
            <nvs>
                <uwb>
                    <device_id>18</device_id>
                    <pan_id>57034</pan_id>
                    <channel>5</channel>
                    <role>initiator</role>
                    <targets>2, 3, 4, 5</targets>
                    <period_ms>20</period_ms>
                    <timeout_ms>120</timeout_ms>
                    <retries>0</retries>
                    <auto_start>false</auto_start>
                </uwb>
                <ble>
                    <mode>peripheral</mode>
                    <peer_ids>2</peer_ids>
                    <auto_start>true</auto_start>
                    <advertising_interval_ms>100</advertising_interval_ms>
                    <scan_interval_ms>100</scan_interval_ms>
                    <scan_window_ms>50</scan_window_ms>
                    <retry_interval_ms>1000</retry_interval_ms>
                    <connection_timeout_ms>5000</connection_timeout_ms>
                    <max_retries>2</max_retries>
                    <rx_message_timeout_ms>500</rx_message_timeout_ms>
                </ble>
            </nvs>
            <range_model>
                <noise_stddev_m>0.015</noise_stddev_m>
                <node_bias_limit_m>0.03</node_bias_limit_m>
                <max_range_m>100.0</max_range_m>
                <seed>0</seed>
            </range_model>
        </plugin>
